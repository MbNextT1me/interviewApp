        </insert>
        <insert tableName="user">
            <column name="NAME" value="User Two"/>
            <column name="DATE_OF_BIRTH" value="1995-05-05"/>
            <column name="PASSWORD" value="$2a$10$Uj1gfjjoiOE.pB2V1/9cn.UwLQK5fxmMNp9kU9dzoZ7pMW4RgJKuG"/>
        </insert>
        <insert tableName="email_data">
            <column name="USER_ID" value="1"/>
            <column name="EMAIL" value="user1@example.com"/>
        </insert>
        <insert tableName="email_data">
            <column name="USER_ID" value="2"/>
            <column name="EMAIL" value="user2@example.com"/>
        </insert>
        <insert tableName="phone_data">
            <column name="USER_ID" value="1"/>
            <column name="PHONE" value="72345678901"/>
        </insert>
        <insert tableName="phone_data">
